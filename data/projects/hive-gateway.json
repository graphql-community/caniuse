      "since": "1.0.0 (partial)",
      "note": "Only supports the [`incremental:0.1` format](https://specs.apollo.dev/incremental/v0.1/). [Read more.](https://the-guild.dev/graphql/hive/docs/gateway/defer-stream)"
    },
    "deprecated-input-values": {
      "since": "",
      "note": ""
    },
    "deprecated-objects": {
      "since": "-"
    },
    "directives-on-directives": {
      "since": "-"
    },
    "directives-on-variable-definitions": {
      "since": "",
      "note": ""
    },
    "executable-documents-descriptions": {
      "since": "-"
    },
    "field-extensions": {
      "since": "?"
    },
    "fragment-arguments": {
      "since": "-"
    },
