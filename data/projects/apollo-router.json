{
  "name": "Apollo Router",
  "type": "gateway",
  "description": "A configurable, high-performance routing runtime for Apollo Federation",
  "url": "https://github.com/apollographql/router",
  "features": {
    "automatic-persisted-queries": {
      "since": "",
      "note": ""
    },
    "capabilities": {
      "since": "-"
    },
    "defer": {
      "since": "1.8.0 (partial)",
      "note": "Apollo Router only supports the [`incremental:0.1` spec](https://specs.apollo.dev/incremental/v0.1/) ([doc](https://www.apollographql.com/docs/graphos/routing/operations/defer))"
    },
    "deprecated-input-values": {
      "since": "",
      "note": ""
    },
    "deprecated-objects": {
      "since": "-"
    },
    "directives-on-directives": {
      "since": "-"
    },
    "directives-on-variable-definitions": {
      "since": "",
      "note": ""
    },
    "executable-documents-descriptions": {
      "since": "-"
    },
    "field-extensions": {
      "since": "?"
    },
    "fragment-arguments": {
      "since": "-"
    },
    "graphql-response+json": {
      "since": "dev-v3.x",
      "note": "Merged in the `dev-v3.x` branch, not released yet ([pr](https://github.com/apollographql/router/pull/9977))"
    },
    "http-batching": {
      "since": "2.6.0",
      "note": "[doc](https://www.apollographql.com/docs/graphos/routing/performance/query-batching)"
    },
    "interfaces-on-interfaces": {
      "since": "",
      "note": ""
    },
    "mutations": {
      "since": "",
      "note": ""
    },
    "on-error": {
      "since": "-"
    },
    "one-of": {
      "since": "-",
      "note": "[apollo-rs pr](https://github.com/apollographql/apollo-rs/pull/1030) is merged. Needs to be included in the router."
    },
    "persisted-documents": {
      "since": "(partial)",
      "note": "The protocol for persisted documents is still TBD"
    },
    "queries": {
      "since": "",
      "note": ""
    },
    "repeatable-directives": {
      "since": "",
      "note": ""
    },
    "semantic-introspection": {
      "since": "-"
    },
    "semantic-non-null": {
      "since": "-"
    },
    "specified-by": {
      "since": "",
      "note": ""
    },
    "stream": {
      "since": "-"
    },
    "subscriptions": {
      "since": "",
      "note": ""
    }
  }
}
