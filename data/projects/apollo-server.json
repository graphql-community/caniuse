{
  "name": "Apollo Server",
  "types": ["server"],
  "description": "A GraphQL server from Apollo that works with any Node.js HTTP framework",
  "url": "https://github.com/apollographql/apollo-server",
  "features": {
    "automatic-persisted-queries": {
      "since": "",
      "note": ""
    },
    "capabilities": {
      "since": "-",
      "note": "Requires support in [GraphQL.js](../project/graphql-js) ([pr](https://github.com/graphql/graphql-js/pull/4523))"
    },
    "defer": {
      "since": "5.1.0",
      "note": "`@defer` support requires `graphql-js:17.0.0-alpha.9` ([doc](https://www.apollographql.com/docs/apollo-server/workflow/requests#incremental-delivery-experimental))"
    },
    "deprecated-input-values": {
      "since": "",
      "note": ""
    },
    "deprecated-objects": {
      "since": "-",
      "note": "Requires support in [GraphQL.js](../project/graphql-js) ([pr](https://github.com/graphql/graphql-js/pull/3818))"
    },
    "directives-on-directives": {
      "since": "n/a",
      "note": "Provided by [GraphQL.js](../project/graphql-js) starting with 16.14.0. On 16.x, the flag can't be passed through `typeDefs`: build the schema with `buildSchema(sdl, { experimentalDirectivesOnDirectiveDefinitions: true })` and pass it as `schema`. Works without the flag on 17.x, which is outside Apollo Server's `graphql@^16.11.0` peer range."
    },
    "directives-on-variable-definitions": {
      "since": "",
      "note": ""
    },
    "empty-selection-sets": {
      "since": "n/a",
      "note": "Provided by [GraphQL.js](../project/graphql-js) starting with 17.1.0, which is outside Apollo Server's `graphql@^16.11.0` peer range."
    },
    "executable-documents-descriptions": {
      "since": "n/a",
      "note": "Provided by [GraphQL.js](../project/graphql-js) starting with 16.12.0"
    },
    "field-extensions": {
      "since": "?"
    },
    "fragment-arguments": {
      "since": "n/a",
      "note": "Provided by [GraphQL.js](../project/graphql-js) starting with 17.0.0-alpha.8, which is outside Apollo Server's `graphql@^16.11.0` peer range."
    },
    "graphql-response+json": {
      "since": "13.0.0",
      "note": "[Apollo Server pull request](https://github.com/apollographql/apollo-server/pull/6827)"
    },
    "http-batching": {
      "since": "1.0.0",
      "note": "Opt-in via `allowBatchedHttpRequests` since 4.0.0 ([doc](https://www.apollographql.com/docs/apollo-server/api/apollo-server#allowbatchedhttprequests))"
    },
    "interfaces-on-interfaces": {
      "since": "",
      "note": ""
    },
    "mutations": {
      "since": "",
      "note": ""
    },
    "on-error": {
      "since": "-",
      "note": "Requires support in [GraphQL.js](../project/graphql-js) ([pr](https://github.com/graphql/graphql-js/pull/4364))"
    },
    "one-of": {
      "since": "n/a",
      "note": "Provided by [GraphQL.js](../project/graphql-js) starting with 16.9.0"
    },
    "persisted-documents": {
      "since": "(partial)",
      "note": "The protocol for persisted documents is still TBD"
    },
    "queries": {
      "since": "",
      "note": ""
    },
    "repeatable-directives": {
      "since": "",
      "note": ""
    },
    "semantic-introspection": {
      "since": "?"
    },
    "semantic-non-null": {
      "since": "?"
    },
    "specified-by": {
      "since": "",
      "note": ""
    },
    "stream": {
      "since": "5.1.0",
      "note": "`@stream` support requires `graphql-js:17.0.0-alpha.9` ([doc](https://www.apollographql.com/docs/apollo-server/workflow/requests#incremental-delivery-experimental))"
    },
    "subscriptions": {
      "since": "",
      "note": ""
    }
  }
}
