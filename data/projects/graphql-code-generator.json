{
  "name": "GraphQL Code Generator",
  "type": "tool",
  "description": "GraphQL code generator with flexible support for custom plugins and templates like Typescript (frontend and backend), React Hooks, resolvers signatures and more.",
  "url": "https://github.com/dotansimha/graphql-code-generator",
  "features": {
    "automatic-persisted-queries": {
      "since": "?"
    },
    "capabilities": {
      "since": "?"
    },
    "defer": {
      "since": "4.0.0",
      "note": "[pr](https://github.com/dotansimha/graphql-code-generator/pull/9196)"
    },
    "deprecated-input-values": {
      "since": "",
      "note": ""
    },
    "deprecated-objects": {
      "since": "?"
    },
    "directives-on-directives": {
      "since": "?"
    },
    "directives-on-variable-definitions": {
      "since": "",
      "note": ""
    },
    "executable-documents-descriptions": {
      "since": "?"
    },
    "field-extensions": {
      "since": "?"
    },
    "fragment-arguments": {
      "since": "7.0.0",
      "note": "Experimental, opt-in via `experimentalFragmentArguments` ([pr](https://github.com/dotansimha/graphql-code-generator/pull/11103))"
    },
    "graphql-response+json": {
      "since": "n/a",
      "note": "GraphQL code generator does not deal with transport concerns."
    },
    "http-batching": {
      "since": "?"
    },
    "http-query": {
      "since": "n/a",
      "note": "GraphQL code generator does not deal with transport concerns."
    },
    "interfaces-on-interfaces": {
      "since": "",
      "note": ""
    },
    "mutations": {
      "since": "",
      "note": ""
    },
    "on-error": {
      "since": "?"
    },
    "one-of": {
      "since": "2.5.0",
      "note": "In `@graphql-codegen/typescript` ([pr](https://github.com/dotansimha/graphql-code-generator/pull/7886))"
    },
    "persisted-documents": {
      "since": "1.3.0 (partial)",
      "note": "The protocol for persisted documents is still TBD. In `@graphql-codegen/client-preset` ([pr](https://github.com/dotansimha/graphql-code-generator/pull/8757))"
