{
  "name": "GraphQL Yoga",
  "type": "server",
  "description": "GraphQL Yoga is a batteries-included cross-platform GraphQL over HTTP spec-compliant GraphQL Server using Envelop and GraphQL Tools that runs anywhere.",
  "url": "https://the-guild.dev/graphql/yoga-server",
  "features": {
    "automatic-persisted-queries": {
      "since": "",
      "note": "With the `@graphql-yoga/plugin-apq` plugin."
    },
    "capabilities": {
      "since": "-"
    },
    "defer": {
      "since": "3.0.0",
      "note": "Requires the defer and stream plugin. [Read more.](https://the-guild.dev/graphql/yoga-server/docs/features/defer-stream)"
    },
    "deprecated-input-values": {
      "since": "",
      "note": ""
    },
    "deprecated-objects": {
      "since": "-"
    },
    "directives-on-directives": {
      "since": "-"
    },
    "directives-on-variable-definitions": {
      "since": "",
      "note": ""
    },
    "executable-documents-descriptions": {
      "since": "-"
    },
    "field-extensions": {
      "since": "?"
    },
    "fragment-arguments": {
      "since": "-"
    },
    "graphql-over-http": {
      "since": "3.4.1",
      "note": "[pr](https://github.com/graphql-hive/graphql-yoga/pull/1616)"
    },
    "graphql-response+json": {
      "since": "3.4.1",
      "note": "[pr](https://github.com/graphql-hive/graphql-yoga/pull/1616)"
    },
