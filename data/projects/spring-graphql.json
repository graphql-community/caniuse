{
  "name": "Spring for GraphQL",
  "types": ["server"],
  "description": "Spring for GraphQL provides support for Spring applications built on GraphQL Java.",
  "url": "https://github.com/spring-projects/spring-graphql",
  "features": {
    "automatic-persisted-queries": {
      "since": "",
      "note": "Via GraphQL Java's `ApolloPersistedQuerySupport` ([doc](https://docs.spring.io/spring-graphql/reference/request-execution.html#execution.graphqlsource.operation-caching))"
    },
    "capabilities": {
      "since": "-",
      "note": "Requires GraphQL Java support ([issue](https://github.com/graphql-java/graphql-java/issues/3992))"
    },
    "defer": {
      "since": "?"
    },
    "deprecated-input-values": {
      "since": "",
      "note": ""
    },
    "deprecated-objects": {
      "since": "-",
      "note": "Requires GraphQL Java support ([issue](https://github.com/graphql-java/graphql-java/issues/4268))"
    },
    "directives-on-directives": {
      "since": "-",
      "note": "Requires GraphQL Java support, merged in `master` but not released yet ([pr](https://github.com/graphql-java/graphql-java/pull/4432))"
    },
    "directives-on-variable-definitions": {
      "since": "",
      "note": ""
    },
    "executable-documents-descriptions": {
      "since": "-",
      "note": "Requires GraphQL Java support, merged in `master` but not released yet ([pr](https://github.com/graphql-java/graphql-java/pull/4392))"
    },
    "field-extensions": {
      "since": "-",
      "note": "Requires GraphQL Java support"
    },
    "fragment-arguments": {
      "since": "-",
      "note": "Requires GraphQL Java support ([issue](https://github.com/graphql-java/graphql-java/issues/3750))"
    },
    "graphql-response+json": {
      "since": "1.4.0",
      "note": "[doc](https://docs.spring.io/spring-graphql/reference/transports.html), [commit](https://github.com/spring-projects/spring-graphql/commit/c5fef9b4ab4bcd3d79a5617534298fe249b95211)"
    },
    "http-batching": {
      "since": "?"
    },
    "http-query": {
      "since": "2.1.0-M1",
      "note": "Opt-in via `GraphQlHttpHandler` builder `httpMethods(HttpMethod.QUERY, ...)` ([commit](https://github.com/spring-projects/spring-graphql/commit/adf8bea16e))"
    },
    "interfaces-on-interfaces": {
      "since": "",
      "note": ""
    },
    "mutations": {
      "since": "",
      "note": ""
    },
    "on-error": {
