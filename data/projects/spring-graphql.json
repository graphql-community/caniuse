    },
    "one-of": {
      "since": "?"
    },
    "persisted-documents": {
      "since": "?",
      "note": ""
    },
    "queries": {
      "since": "",
      "note": ""
    },
    "repeatable-directives": {
      "since": "",
      "note": ""
    },
    "semantic-introspection": {
      "since": "?"
    },
    "semantic-non-null": {
      "since": "?"
    },
    "specified-by": {
      "since": "",
      "note": ""
    },
    "stream": {
      "since": "-",
      "note": "Requires GraphQL Java support ([issue](https://github.com/graphql-java/graphql-java/issues/4497))"
    },
    "subscriptions": {
      "since": "",
      "note": ""
    }
